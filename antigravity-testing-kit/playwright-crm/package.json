{
  "name": "playwright-crm",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation for Perfex CRM - Customers module",
  "scripts": {
    "recon": "npx playwright test --config=playwright.recon.config.ts --headed",
    "test": "npx playwright test src/tests/",
    "test:headed": "npx playwright test src/tests/ --headed",
    "test:customers": "npx playwright test src/tests/customers/ --headed",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0",
    "typescript": "^5.4.0"
  }
}
