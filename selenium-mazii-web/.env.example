# =============================================
# Mazii Selenium Web Test Configuration
# Copy file này thành .env và điền giá trị thực
# =============================================

# Mazii web URL
BASE_URL=https://mazii.net

# Browser: chrome | firefox | edge (default: chrome)
BROWSER=chrome

# Headless mode: true | false
HEADLESS=false

# Window size (pixels)
BROWSER_WIDTH=1440
BROWSER_HEIGHT=900

# Test accounts
ACCOUNT_PREMIUM_EMAIL=premium_test@mazii.net
ACCOUNT_PREMIUM_PASSWORD=TestPass@123
ACCOUNT_STANDARD_EMAIL=standard_test@mazii.net
ACCOUNT_STANDARD_PASSWORD=TestPass@123

# Timeouts (seconds)
IMPLICIT_WAIT=10
EXPLICIT_WAIT=15
PAGE_LOAD_TIMEOUT=30
