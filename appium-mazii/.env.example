# =============================================
# Mazii Appium Test Configuration
# Copy file này thành .env và điền giá trị thực
# =============================================

# Appium Server
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Platform: android hoặc ios
PLATFORM=android

# Android capabilities
ANDROID_APP_PACKAGE=net.mazii.app
ANDROID_APP_ACTIVITY=com.mazii.app.MainActivity
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_PLATFORM_VERSION=13.0
ANDROID_APP_PATH=apps/mazii.apk

# iOS capabilities
IOS_BUNDLE_ID=com.mazii.app
IOS_DEVICE_NAME=iPhone 14
IOS_PLATFORM_VERSION=16.0
IOS_APP_PATH=apps/mazii.ipa
IOS_UDID=

# Test accounts
ACCOUNT_PREMIUM_EMAIL=premium_test@mazii.net
ACCOUNT_PREMIUM_PASSWORD=TestPass@123
ACCOUNT_STANDARD_EMAIL=standard_test@mazii.net
ACCOUNT_STANDARD_PASSWORD=TestPass@123

# Timeouts (seconds)
IMPLICIT_WAIT=10
EXPLICIT_WAIT=15
PAGE_LOAD_TIMEOUT=30
